<launch>
  <arg name="map_path" description="Required PCD, PLY, H5, or HDF5 input map"/>
  <arg name="converted_map_path" default="" description="Optional new HDF5 output for pointcloud input"/>
  <arg name="params_file" default="$(find-pkg-share vq_map_server)/config/vq_map_server.yaml"/>
  <arg name="conversion_params_file" default="$(find-pkg-share vq_map_server)/config/conversion.yaml"/>
  <arg name="use_sim_time" default="false"/>
  <node pkg="vq_map_server" exec="vq_map_server_node" name="vq_map_server" output="screen">
    <param from="$(var conversion_params_file)"/>
    <param from="$(var params_file)"/>
    <param name="map_path" value="$(var map_path)" type="str"/>
    <param name="converted_map_path" value="$(var converted_map_path)" type="str"/>
    <param name="use_sim_time" value="$(var use_sim_time)" type="bool"/>
  </node>
</launch>
