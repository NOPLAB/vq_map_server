<?xml version="1.0"?>
<package format="3">
  <name>vq_map_server</name>
  <version>0.1.0</version>
  <description>Vector-quantized 2D and 3D occupancy map conversion and static map distribution.</description>
  <maintainer email="noplab90@gmail.com">nop</maintainer>
  <author email="noplab90@gmail.com">nop</author>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rcl_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>nav2_map_server</depend>
  <depend>libpcl-all-dev</depend>
  <depend>libhdf5-dev</depend>
  <depend>yaml-cpp</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>ros2run</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>launch_xml</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
